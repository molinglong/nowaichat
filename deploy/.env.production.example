# =====================================================
# 生产环境变量模板
# 复制为 .env.production 并填入实际值
#   cp deploy/.env.production.example deploy/.env.production
#   vim deploy/.env.production
# 这个文件绝不要 commit 到 git
# =====================================================

# 数据库密码(强随机)
POSTGRES_USER=admin
POSTGRES_PASSWORD=请改成强随机字符串
POSTGRES_DB=aichatt

# NextAuth 配置
# 生成命令: openssl rand -base64 32
AUTH_SECRET=请改成 openssl rand -base64 32 的输出
# 部署后的访问地址,末尾不要 /
AUTH_URL=https://your-domain.com

# 你的域名(用于 Let's Encrypt 申请证书)
DOMAIN=your-domain.com
# 如果域名带 www 也想用,加到这里,空格分隔
CERTBOT_EMAIL=you@example.com
