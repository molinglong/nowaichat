# =====================================================
# 生产环境变量模板
# 复制为 .env.production 并填入实际值
#   cp deploy/.env.production.example deploy/.env.production
#   vim deploy/.env.production
# 这个文件绝不要 commit 到 git
# =====================================================

# 数据库密码(强随机)
POSTGRES_USER=admin
POSTGRES_PASSWORD=请改成强随机字符串
POSTGRES_DB=aichatt

# NextAuth 配置
# 生成命令: openssl rand -base64 32
AUTH_SECRET=请改成 openssl rand -base64 32 的输出
# 部署后的访问地址,末尾不要 /
AUTH_URL=https://your-domain.com

# API Key 加密密钥(aes-256-gcm 派生源)
# 生成命令: openssl rand -base64 32
# 注意: 部署后不要随意更换,换了之后已保存的 API Key 将无法解密,需在设置页重新保存
ENCRYPTION_KEY=请改成 openssl rand -base64 32 的输出

# 通义千问服务器级兜底 Key(可选): 未在设置页配置 Key 的用户可直接用 qianwen 模型聊天
# API_KEY_DASHSCOPE=

# 高德地图(plan_trip 行程卡片)
# AMAP_JS_KEY/AMAP_JS_SEC:「Web端(JS API)」类型 Key+安全密钥(经 /api/amap-config 下发到浏览器渲染地图,防盗用靠高德控制台域名白名单)
# AMAP_WS_KEY:「Web服务」类型 Key(仅服务端 POI 坐标校准,控制台需把服务器出口 IP 加入白名单)
AMAP_JS_KEY=
AMAP_JS_SEC=
AMAP_WS_KEY=

# 你的域名(用于 Let's Encrypt 申请证书)
DOMAIN=your-domain.com
# 如果域名带 www 也想用,加到这里,空格分隔
CERTBOT_EMAIL=you@example.com
