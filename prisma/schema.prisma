generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  apiKeys       ApiKey[]
  conversations Conversation[]
  memories      Memory[]
  customModels  CustomModel[]
  generatedImages GeneratedImage[]
  searchApiKeys  SearchApiKey[]
  courses       Course[]
  providerModelOverrides ProviderModelOverride[]
  memoryEnabled Boolean   @default(true)
  clarifyEnabled Boolean  @default(true)
  imageModel    String   @default("builtin:wanx2.1-t2i-turbo")
  imageSize     String   @default("1024*1024")
  imageModels   ImageModel[]
  masks         Mask[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ApiKey {
  id           String   @id @default(cuid())
  userId       String
  provider     String   // openai, anthropic, deepseek, qianwen, wenxin
  encryptedKey String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Conversation {
  id            String   @id @default(cuid())
  userId        String
  title         String   @default("新对话")
  model         String   @default("gpt-4o")
  mode          String   @default("single") // single | compare
  compareModels String?  // JSON 数组,如 ["gpt-4o","claude-sonnet"]
  styleOffset   Int      @default(50)
  stylePreset   String?  // 新版风格预设:id 来自 STYLE_PRESETS(balanced/practical/dev/editor/mentor/scholar). 为 null 时视为 balanced
  maskId        String?  // 面具 id:内置面具 id 来自 BUILTIN_MASKS(如 translator);将来用户自定义面具用 user:<cuid> 前缀. 为 null 时不启用面具
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   Message[]
  summaries  ConversationSummary[]

  @@index([userId, updatedAt])
}

// 用户自定义面具 (P1): maskId = 'user:<cuid>' 前缀
model Mask {
  id           String    @id @default(cuid())
  userId       String
  name         String                    // 显示名，必填 1-30
  avatar       String    @default("🎭")  // emoji 头像，1-2 字符
  description  String    @default("")    // 一句话定位，≤50
  systemPrompt String                   // 人格指令，≤8000
  fewShot      Json?                   // [{role: 'user'|'assistant', content}], ≤4 轮
  stylePreset  String?                 // 来自 STYLE_PRESETS(balanced/practical/dev/editor/mentor/scholar)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

// 会话级"远期摘要": 当对话历史接近模型上下文窗口时,
// 把较早的若干轮消息压缩为一段摘要存到这里，后续请求把它作为,后续请求把它作为
// 一条 system 注入,代替被压缩的原文,防止长对话撞窗口失忆。
// 同一会话可有多个摘要(分代压缩),最新一条代表"当前最早期"。
model ConversationSummary {
  id             String   @id @default(cuid())
  conversationId String
  // 覆盖范围:从第一条到哪一条消息(以 Message.id 标识)。
  // rangeStart 可以为空,表示从对话开头;rangeEnd 为该次压缩最后一条消息 id。
  rangeStart     String?
  rangeEnd       String   // 该次压缩覆盖的最后一条消息 id
  content        String   // 摘要文本
  // 用于回查:压缩时正在使用的模型 id,便于后续按窗口大小决策
  modelId        String?
  // 摘要覆盖的原始消息对数(估算),用于调试/统计
  coveredMessages Int     @default(0)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Message {
  id               String   @id @default(cuid())
  conversationId   String
  role             String   // user, assistant, system
  content          String
  reasoning        String?  // AI 思考过程（深度思考 / 推理模型）
  attachments      String?  // JSON string for file URLs
  // 结构化 UI 提示（JSON 字符串），按 kind 决定前端如何渲染。
  // 例：{"kind":"branch_summary","version":1,"sourceId":"cuid","sourceTitle":"...","branchedAt":"2026-09-03T..."}
  // 写入规则：仅后端写入；前端按 kind 分发渲染分支。
  metadata         String?
  model            String?  // assistant 消息所属模型 id
  groupId          String?  // 同一轮对比共享的分组 id
  promptTokens     Int?     // 本轮输入 token 数（assistant 消息）
  completionTokens Int?     // 本轮输出 token 数（assistant 消息）
  createdAt        DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, groupId])
}

model Memory {
  id           String   @id @default(cuid())
  userId       String
  category     String   @default("general")
  content      String
  source       String   @default("auto") // auto 自动提取 | manual 手动添加 | imported 从其他 AI 导入
  sourceDetail String?  // 导入来源名称，如 "ChatGPT" / "Claude" / "Grok"，仅 source=imported 时使用
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 用户自定义生图模型(OpenAI 兼容文生图端点)
model ImageModel {
  id           String   @id @default(cuid())
  userId       String
  name         String   // 显示名称
  modelId      String   // 实际模型标识,如 "dall-e-3" / "stable-diffusion-xl"
  baseURL      String   // API 端点,如 https://api.openai.com/v1
  apiKeySource String   @default("provider") // "provider" 复用服务商 Key | "own" 独立 Key
  apiKey       String?  // 独立 API Key(加密),keySource=own 时使用
  keyProvider  String?  // 复用哪个服务商的 Key,keySource=provider 时使用
  contextWindow Int     @default(2048) // 备注/上下文限制
  supportsSize Boolean  @default(true)  // 是否支持自定义尺寸
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, modelId])
  @@index([userId])
}

// 用户预置模型覆盖：管理每个 provider 下内置模型的可见性 + 用户添加的模型 ID
// 用法：
//   - isHidden=true 表示「隐藏该预置模型」
//   - isHidden=false + name 非空 = 「用户为该 provider 新增的模型（复用该 provider 的 Key）」
model ProviderModelOverride {
  id          String   @id @default(cuid())
  userId      String
  provider    String   // "deepseek" / "openai" / "anthropic" / ...
  modelId     String   // "deepseek-chat" / "gpt-5" / "claude-sonnet-4-5" / ...

  isHidden    Boolean  @default(false)

  // 仅 isHidden=false 时生效（新增模型必填）
  name              String
  contextWindow     Int      @default(32768)
  supportsVision    Boolean  @default(false)
  supportsFiles     Boolean  @default(false)
  supportsReasoning Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, modelId])
  @@index([userId])
}

// 用户自定义模型(OpenAI 兼容协议)
model CustomModel {
  id               String   @id @default(cuid())
  userId           String
  name             String // 显示名
  modelId          String // 实际模型标识,如 "gpt-4o-mini" / "qwen2.5:7b"
  baseURL          String // OpenAI 兼容端点,如 https://api.siliconflow.cn/v1
  protocol         String   @default("auto") // auto、chat、responses 或 anthropic
  apiKey           String? // 独立 API Key(加密);为空时复用 keyProvider 的 Key 或免鉴权
  keyProvider      String? // 复用已有服务商 Key 的 provider id(如 "openai")
  contextWindow    Int      @default(32768)
  supportsVision   Boolean  @default(false)
  supportsFiles    Boolean  @default(false)
  supportsReasoning Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, modelId])
  @@index([userId])
}

// 用户通过"生图工作台"生成的图片记录
model GeneratedImage {
  id        String   @id @default(cuid())
  userId    String
  prompt    String   // 用户输入的提示词
  url       String   // 相对路径,如 /uploads/wanx-xxx.png
  model     String   @default("builtin:wanx2.1-t2i-turbo")
  width     Int      @default(1024)
  height    Int      @default(1024)
  size      String   @default("1024*1024") // 生图请求时的尺寸参数(如 1024*1024 / 720*1280 / 1280*720)
  // 关联来源: workspace = 来自生图工作台; chat = 来自对话中的 [IMG] 触发
  source    String   @default("workspace")
  // 二创链路: parentId 指向被修改的原图,null = 首次生成
  parentId  String?
  // 生成方式: t2i(文生图) | edit(以图生图/img2img) | inpaint(局部重绘) | variation(变体)
  editType  String   @default("t2i")
  // inpaint 用: 涂抹区域相对原图的归一化坐标 JSON,形如 {"x":0.1,"y":0.2,"w":0.3,"h":0.4}
  maskRect  String?
  // 文生图时用户上传的参考图(相对路径 /uploads/xxx.png),null = 纯文生图
  referenceImageUrl String?
  createdAt DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   GeneratedImage?  @relation("ImageDerivation", fields: [parentId], references: [id], onDelete: SetNull)
  children GeneratedImage[] @relation("ImageDerivation")

  @@index([userId, createdAt])
  @@index([parentId])
}

// 联网搜索 API Key（独立于模型 ApiKey 表）
// 目前支持：qianfan（百度千帆）
model SearchApiKey {
  id           String   @id @default(cuid())
  userId       String
  engine       String   // qianfan | tavily | ...
  encryptedKey String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, engine])
  @@index([userId])
}

// ===================== 教学模式(teach mode) =====================
// 课程(Course) 与某个 Conversation 一一对应,用于把对话生成的结构化课程
// (chapters) 持久化下来,便于 CourseProgress 跟踪学习进度,
// WrongQuestion 收集错题用于间隔重复复习。

model Course {
  id             String   @id @default(cuid())
  userId         String
  title          String
  sourceFile     String?  // 来源文件名(可选,用于显示)
  chapters       Json     // 章节列表,结构由前端约定
  conversationId String?  @unique  // 与生成它的会话一一对应(允许尚未关联会话的课程)
  createdAt      DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress CourseProgress?
  wrongs   WrongQuestion[]

  @@index([userId])
}

model CourseProgress {
  id              String   @id @default(cuid())
  userId          String
  courseId        String   @unique
  currentChapter  Int      @default(0)
  masteredChapters Json    @default("[]")
  weakPoints      Json     @default("[]")
  updatedAt       DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model WrongQuestion {
  id            String   @id @default(cuid())
  userId        String
  courseId      String
  chapterIdx    Int
  question      String
  userAnswer    String
  correctAnswer String
  explanation   String
  resolved      Boolean  @default(false)
  createdAt     DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId, courseId, resolved])
}
