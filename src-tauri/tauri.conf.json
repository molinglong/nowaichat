{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aichatt",
  "version": "0.1.0",
  "identifier": "com.aichatt.desktop",
  "build": {
    "frontendDist": "./splash",
    "devUrl": "http://localhost:3456",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "aichatt",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "fullscreen": false,
        "center": true,
        "visible": true
      },
      {
        "label": "buddy",
        "title": "搭子",
        "width": 120,
        "height": 120,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "url": "/buddy/"
      },
      {
        "label": "settings",
        "title": "设置",
        "width": 780,
        "height": 640,
        "minWidth": 560,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "visible": false,
        "url": "/settings-window/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "AI 多模型对话助手",
    "longDescription": "支持 OpenAI、Anthropic、DeepSeek、通义千问、文心一言的多模型 AI 对话平台桌面客户端"
  }
}